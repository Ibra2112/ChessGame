ChessServer ..> Position : uses
ChessServer ..> Piece : uses
ChessServer ..> NetworkMessage : uses
ChessClient ..> Board : uses
ChessClient ..> Position : uses
ChessClient ..> NetworkMessage : uses

' Package grouping
package "board" {
    Board
    Position
}

package "pieces" {
    Piece
    Pawn
    Rook
    Knight
    Bishop
    Queen
    King
}

package "game" {
    Player
    AIPlayer
    Game
}

package "gui" {
    ChessGUI
    ChessBoardPanel
    GameHistoryPanel
    SettingsDialog
    MoveRecord
    GameState
}

package "network" {
    ChessServer
    ChessClient
    NetworkMessage
}

note right of Piece
    Abstract class defining
    common behavior for all
    chess pieces
end note

note right of AIPlayer
    Uses Minimax algorithm
    with Alpha-Beta pruning
    for move selection
end note

note right of ChessServer
    Hosts network games
    and synchronizes state
    between two clients
end note

@enduml

