Game "1" *-- "1" Board
Game "1" *-- "2" Player
ChessGUI "1" *-- "1" Board
ChessGUI "1" *-- "1" ChessBoardPanel
ChessGUI "1" *-- "1" GameHistoryPanel
ChessGUI "1" *-- "0..2" AIPlayer
ChessGUI "1" *-- "0..1" ChessClient
ChessGUI "1" *-- "*" MoveRecord
ChessGUI "1" *-- "*" Board : boardHistory
ChessBoardPanel "1" *-- "1" Board
GameState "1" *-- "1" Board
GameState "1" *-- "*" MoveRecord
MoveRecord "1" *-- "2" Position
Board "1" *-- "64" Position : squares
Board "1" *-- "*" Piece : capturedPieces
Board "1" *-- "0..64" Piece : squares
Piece "1" *-- "1" Position
AIPlayer "1" *-- "*" Move
Move "1" *-- "2" Position
ChessServer "1" *-- "1" Board
ChessServer "1" *-- "2" Socket
ChessClient "1" *-- "1" Socket
ChessClient "1" *-- "1" NetworkMessageListener
NetworkMessage "1" *-- "0..1" Position : from
NetworkMessage "1" *-- "0..1" Position : to
NetworkMessage "1" *-- "0..1" Board
NetworkMessage "1" *-- "1" MessageType

